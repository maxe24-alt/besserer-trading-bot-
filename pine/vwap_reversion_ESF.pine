//@version=6
// ---------------------------------------------------------------------
// VWAP Reversion (20d)
// Erzeugt vom Python-Backtester - siehe README.
//
// Gedacht fuer: CME_MINI:ES1!   Zeiteinheit: 1 Tag (D)
// Gleiche Bedingungen wie im Python-Lauf: 100000.0 USD Start, 0.1 % Gebuehr je Seite, 1.0 Tick Slippage.
//
// Positionsgroesse: 1 Kontrakt(e) fest (E-mini S&P 500, 50 USD je Punkt).
// Prozent vom Kapital geht bei Futures nicht: ein Kontrakt ist mehr wert
// als das Startkapital, TradingView rundet dann auf null Kontrakte ab
// und handelt gar nicht. Vergleichbarer Python-Lauf:
//   python -m backtester run <strategie> --symbol ES=F --contracts 1
//
// Bekannte Abweichungen gegenueber der Python-Engine:
//   Historie: Im TradingView-Gratisplan ist die Zahl der Bars begrenzt, ein
//   sehr langer Intraday-Test wird dort also kuerzer ausfallen.
//   Anlaufphase: Supertrend und Ichimoku starten in Pine minimal anders,
//   das betrifft nur die ersten Bars.
// ---------------------------------------------------------------------

strategy(
     title = "VWAP Reversion (20d) [backtester]",
     shorttitle = "VWAP Reversion",
     overlay = true,
     initial_capital = 100000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0.1,
     slippage = 1,
     pyramiding = 0,
     process_orders_on_close = false,
     calc_on_every_tick = false,
     currency = currency.USD)

// --- Zeitfenster -----------------------------------------------------
// Standardmaessig aus: der Test laeuft ueber alles, was der Chart hergibt.
// Ein Enddatum in der Vergangenheit wuerde sonst die juengsten Bars
// stillschweigend ausklammern - und auf kurzen Zeiteinheiten bleibt dann
// womoeglich gar kein Bar uebrig.
useWindow = input.bool(false, "Zeitfenster begrenzen", group="Zeitraum")
startDate = input.time(timestamp("01 Jan 2015 00:00 +0000"), "Backtest ab", group="Zeitraum")
endDate = input.time(timestamp("01 Sep 2026 00:00 +0000"), "Backtest bis", group="Zeitraum")
inWindow = not useWindow or (time >= startDate and time <= endDate)

// --- Positionsgroesse -------------------------------------------------
contracts = input.float(1, "Kontrakte je Trade", minval=0.01, step=1, group="Positionsgroesse")

// --- Parameter -------------------------------------------------------
vwapLen = input.int(20, "VWAP-Fenster", minval=5, group="Strategie")
thresholdPct = input.float(1.0, "Abstand in Prozent", minval=0.0, step=0.1, group="Strategie")

// --- Indikatoren -----------------------------------------------------
// Rollierender VWAP; ohne Volumen faellt er auf den Typical Price zurueck
typicalPrice = hlc3
volumeSum = math.sum(volume, vwapLen)
vwapValue = volumeSum > 0 ? math.sum(typicalPrice * volume, vwapLen) / volumeSum : ta.sma(typicalPrice, vwapLen)
lowerBand = vwapValue * (1 - thresholdPct / 100)

// --- Regeln ----------------------------------------------------------
longEntry = close < lowerBand
longExit = close > vwapValue

// --- Orders ----------------------------------------------------------
// Pine fuellt Orders zur Eroeffnung der naechsten Bar - genau wie die
// Python-Engine. Der Ausstieg wird zuerst geprueft, damit an einer Bar
// mit beiden Signalen nicht sofort neu eingestiegen wird.
if inWindow
    if longExit and strategy.position_size > 0
        strategy.close("Long", comment="Ausstieg")
    if longEntry and strategy.position_size <= 0
        strategy.entry("Long", strategy.long, qty = contracts)

// Nach dem Zeitfenster wird glattgestellt.
if useWindow and not inWindow and strategy.position_size != 0
    strategy.close_all(comment="Zeitfenster Ende")

// --- Darstellung -----------------------------------------------------
plot(vwapValue, "VWAP", color=color.new(#f0b232, 0), linewidth=2)
plot(lowerBand, "Kaufschwelle", color=color.new(#5ce1a6, 0))

bgcolor(strategy.position_size > 0 ? color.new(#5ce1a6, 92) : na, title="Im Markt")
